# --- Normalize all text files to LF ---
* text=auto eol=lf

# --- Code files ---
*.py     text eol=lf
*.ipynb  text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# --- Config files ---
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# --- Binary files (no conversion) ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.exe binary
*.zip binary
*.tar binary
*.gz  binary